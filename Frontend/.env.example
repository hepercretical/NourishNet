# Optional public API prefix. Local Vite development proxies /api to the backend.
# All VITE_ variables are public. Never put credentials here.
VITE_API_BASE_URL=/api
# Hosted mode is opt-in. This URL is public; never add a database URL here.
VITE_AUTH_MODE=local
VITE_NEON_AUTH_URL=https://REPLACE_WITH_BRANCH_AUTH_HOST/neondb/auth
