{
  "name": "nourishnet-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "node --env-file-if-exists=.env scripts/database.js check",
    "db:migrate": "node --env-file-if-exists=.env scripts/database.js migrate",
    "db:seed": "node --env-file-if-exists=.env scripts/database.js seed",
    "db:verify": "node --env-file-if-exists=.env scripts/verify-database.js",
    "catalog:plan": "node scripts/local-catalog.js plan",
    "catalog:inspect": "node --env-file-if-exists=.env scripts/local-catalog.js inspect",
    "verify:accounts": "node --env-file-if-exists=.env scripts/verify-accounts.js",
    "verify:diary": "node --env-file-if-exists=.env scripts/verify-diary.js",
    "verify:catalog": "node --env-file-if-exists=.env scripts/verify-local-catalog.js",
    "verify:barcodes": "node --env-file-if-exists=.env scripts/verify-local-barcodes.js",
    "verify:submissions": "node --env-file-if-exists=.env scripts/verify-local-submissions.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "jose": "6.2.17",
    "pg": "8.23.1"
  }
}
