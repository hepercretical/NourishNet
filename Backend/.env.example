# Local development only. No database or credentials are needed for Plan-01.
HOST=127.0.0.1
PORT=3001

# Optional Plan-02 database commands. Health/dev startup needs no database.
# Use separate synthetic development/preview data; never copy production rows.
# Local setup helper creates an ignored .env with a random local-only password.
DATABASE_ENV=development
DATABASE_SYNTHETIC_ONLY=true
DATABASE_EXPECTED_HOST=127.0.0.1
DATABASE_EXPECTED_NAME=nourishnet_plan02_dev
DATABASE_URL=postgresql://local_user:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/nourishnet_plan02_dev

# Hosted internal testing: configure these in Netlify Functions runtime scope.
# Keep DATABASE_ENV=development and DATABASE_SYNTHETIC_ONLY=true for this phase.
# DATABASE_EXPECTED_HOST must exactly match the pooled Neon DATABASE_URL hostname.
# DATABASE_EXPECTED_NAME must match its database name. Never expose DATABASE_URL to Vite.
APP_ORIGIN=https://thenourishnet.netlify.app
NEON_AUTH_BASE_URL=https://REPLACE_WITH_BRANCH_AUTH_HOST/neondb/auth
# Comma-separated approved tester mailboxes, supplied privately. Empty denies access.
NEON_TEST_EMAILS=
